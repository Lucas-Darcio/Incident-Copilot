# Copie este arquivo para .env e preencha com sua chave real:
#   cp .env.example .env
#
# Obtenha sua chave em: https://aistudio.google.com/apikey

GOOGLE_API_KEY=sua_chave_aqui

# Senha do Postgres usado pelo checkpointer do LangGraph (Fase 5).
# Pode ser qualquer senha — é só para o banco local do projeto.
POSTGRES_PASSWORD=escolha_uma_senha_aqui
